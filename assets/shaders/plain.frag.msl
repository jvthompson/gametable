#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 out_var_SV_Target [[color(0)]];
};

struct main0_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
    float4 in_var_TEXCOORD1 [[user(locn1)]];
};

fragment main0_out main0(main0_in in [[stage_in]], texture2d<float> source_texture [[texture(0)]], sampler source_textureSmplr [[sampler(0)]])
{
    main0_out out = {};
    out.out_var_SV_Target = source_texture.sample(source_textureSmplr, in.in_var_TEXCOORD0) * in.in_var_TEXCOORD1;
    return out;
}

